# Solo configuración pública. No añadas contraseñas ni tokens en este archivo.
COMPOSE_PROJECT_NAME=compose-hardening-wordpress
PROXY_NETWORK=proxy
PROXY_NETWORK_EXTERNAL=true

# URL canónica pública. El proxy termina TLS y reenvía a WordPress por HTTP.
WORDPRESS_PUBLIC_URL=https://wordpress.example.com
# Habilítalo solo si WordPress únicamente recibe tráfico a través de proxies de confianza.
WORDPRESS_TRUST_PROXY_HEADERS=true

# Puerto publicado siempre en loopback por defecto, también con proxy Docker.
# Para un proxy remoto usa una IP privada concreta y limita el firewall a ese proxy.
PUBLISH_IP=127.0.0.1
WORDPRESS_PUBLISHED_PORT=8080

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_TABLE_PREFIX=wp_

# Límites de recursos. Ajústalos a la capacidad real del host.
WORDPRESS_MEMORY_LIMIT=768m
WORDPRESS_CPU_LIMIT=1.0
WORDPRESS_PIDS_LIMIT=200

MARIADB_MEMORY_LIMIT=768m
MARIADB_CPU_LIMIT=1.0
MARIADB_PIDS_LIMIT=200
